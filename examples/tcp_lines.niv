define count_protocol_lines
takes {
    stream is TcpStream
}
gives Int or Problem
needs Network
{
    keep lines set std.iter.tcp_lines with {
        stream set stream
        maximum_bytes set 65536
        timeout set 5.0
    } or give
    change count set 0
    each line within lines {
        keep text set line or give
        change count to count + 1
    }
    give ok(count)
}
