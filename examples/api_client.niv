define fetch_status
takes {
    url is String
}
gives String or Problem
needs Network
{
    keep response set std.web.request with {
        method set "GET"
        url set url
        headers set std.web.headers with {}
        body set ""
        timeout set 5.0
        maximum set 1048576
    } or give
    give ok(text "{response.status}")
}

fetch_status with { url set "https://example.com" }
