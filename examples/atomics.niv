define count
gives Int or String
needs Task
{
    keep counter set std.atomics.create with { value set 0 }

    define increment
    gives Null or String
    {
        change index set 0
        repeat index < 100 {
            keep previous set std.atomics.add with {
                atomic set counter
                amount set 1
            } or give
            change index to index + 1
        }
        give ok(none)
    }

    keep completed set together [start increment, start increment] or give
    give ok(std.atomics.load with { atomic set counter })
}

choose count with {} {
    case Ok carries value => value
    case Err carries problem => -1
}
