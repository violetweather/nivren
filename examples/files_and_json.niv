shape Document holds {
    title is String
    published is Bool
}

define load_document
takes {
    path is String
}
gives String or Problem
needs FileRead
{
    keep opened set std.files.open_read with { path set path }
    using file set opened or give {
        keep source set std.files.read_from with { file set file maximum set 1048576 } or give
        keep document set std.json.decode with { schema set Document source set source } or give
        give std.json.encode with { value set document }
    }
}

load_document with { path set "data.json" }
