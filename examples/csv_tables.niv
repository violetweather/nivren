define summarize
takes {
    source is String
}
gives String or Problem
{
    keep headers set ["name", "score"]
    keep rows set std.csv.decode with {
        source set source
        headers set headers
        delimiter set ","
        maximum_rows set 10000
    } or give
    when len(rows) == 0 { give ok("no rows") }
    give ok(std.map.get with { map set rows[0] key set "name" } ?? "missing name")
}

keep result set summarize with { source set "Nivren,100\r\n" }
keep message set choose result {
    case Ok carries name => name
    case Err carries problem => problem.message
}
show(message)
