define store_password
takes {
    password is String
}
gives String or Problem
needs Random
{
    keep salt set std.crypto.random_bytes with { length set 16 } or give
    give std.crypto.password_hash with {
        password set password
        salt set salt
        memory_kib set 19456
        iterations set 2
        lanes set 1
    }
}

define accepts
takes {
    password is String
    encoded is String
}
gives Bool or Problem
{
    give std.crypto.password_verify with { password set password encoded set encoded }
}

// A project calling store_password grants Random in niv.toml. Verification
// needs no ambient authority and rejects hostile Argon2 parameters early.
