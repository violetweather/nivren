define store_password(password: String) gives Result<String, String> needs Random {
    keep salt = std.crypto.random_bytes(16) or give
    give std.crypto.password_hash(password, salt, 19456, 2, 1)
}

define accepts(password: String, encoded: String) gives Result<Bool, String> {
    give std.crypto.password_verify(password, encoded)
}

// A project calling store_password grants Random in niv.toml. Verification
// needs no ambient authority and rejects hostile Argon2 parameters early.
