define greet
takes {
    name is String
}
gives String
{
    give "Hello, " + name + "!"
}

keep language is String set "Nivren"
show(greet with { name set language })

change sum set 0
change number set 1
repeat number <= 10 {
    change sum to sum + number
    change number to number + 1
}
show("The sum from 1 through 10 is:")
show(sum)
