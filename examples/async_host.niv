define read_sensor
takes {
    port is Int
}
gives String or Problem
needs Native, Task
{
    keep request set "{\"port\":" + std.int.format with { value set port } + "}"
    keep queued set std.host.invoke_async with {
        name set "device.read"
        request set request
    } or give
    give wait queued
}

keep sample set read_sensor with { port set 7 }
choose sample {
    case Ok carries value => value
    case Err carries problem => problem.message
}
