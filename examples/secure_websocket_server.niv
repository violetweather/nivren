define serve(certificate_pem: String, private_key_pem: String) gives Result<String, String> needs Network {
    keep policy = std.web.tls_options()
    keep opened = std.web.websocket_secure_listen("127.0.0.1", 8443, certificate_pem, private_key_pem, policy) or give
    using listener = opened {
        keep accepted = std.web.websocket_secure_accept(listener, 30.0) or give
        using socket = accepted {
            keep message = std.web.websocket_receive(socket, 65536) or give
            keep sent = std.web.websocket_send(socket, "secure:" + message) or give
            give ok(message)
        }
    }
}

define serve_mutual(certificate_pem: String, private_key_pem: String, client_ca_pem: String) gives Result<String, String> needs Network {
    keep auth = std.map.set(std.web.tls_options(), "client_auth", "required")
    keep policy = std.map.set(auth, "client_ca_pem", client_ca_pem)
    keep opened = std.web.websocket_secure_listen("127.0.0.1", 9443, certificate_pem, private_key_pem, policy) or give
    using listener = opened {
        keep accepted = std.web.websocket_secure_accept(listener, 30.0) or give
        using socket = accepted {
            give std.web.websocket_receive(socket, 65536)
        }
    }
}

show("Call serve with PEM certificate and private-key text from a secret source.")
