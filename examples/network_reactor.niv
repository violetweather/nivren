define first_readable
takes {
    streams is [TcpStream]
}
gives maybe Int or Problem
needs Network
{
    give std.net.wait_ready_any with { streams set streams interest set Interest.Read timeout set 5.0 }
}

define exchange
takes {
    stream is TcpStream
    message is String
}
gives String or Problem
needs Network
{
    keep sent set std.net.write_ready with {
        stream set stream
        value set message
        chunk_size set 65536
        timeout set 5.0
    } or give
    give std.net.read_ready with { stream set stream maximum set 1048576 timeout set 5.0 }
}

show("Use first_readable for up to 1024 streams, then exchange with bounded adapters.")
