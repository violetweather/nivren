shape Event holds {
    id is Int
    kind is String
}

define first_event
takes {
    path is String
}
gives maybe Event or Problem
needs FileRead
{
    keep opened set std.files.open_read with { path set path } or give
    using file set opened {
        give std.json.read_next_as with {
            schema set Event
            file set file
            maximum set 65536
        }
    }
}

first_event with { path set "events.ndjson" }
