define echo_once
takes {
    listener is TcpListener
}
gives Null or String
needs Network
{
    using server = listener {
        keep accepted set std.net.accept with { listener set server timeout set 30.0 }
        using connection = accepted or give {
            keep request set std.web.read_request with {
                stream set connection
                maximum set 65536
            } or give
            keep upgraded set std.web.websocket_accept with {
                stream set connection
                request set request
            }
            using socket = upgraded or give {
                keep message set std.web.websocket_receive with {
                    websocket set socket
                    maximum set 1048576
                } or give
                keep sent set std.web.websocket_send with {
                    websocket set socket
                    message set "Nivren heard: " + message
                } or give
                give ok(none)
            }
        }
    }
}

keep opened set std.net.listen with { host set "127.0.0.1" port set 8080 }
choose opened {
    case Ok carries listener => echo_once with { listener set listener }
    case Err carries problem => err(problem)
}
