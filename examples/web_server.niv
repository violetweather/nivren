define serve_once
takes {
    listener is TcpListener
}
gives Nothing or Problem
needs Network
{
    using server set listener {
        keep accepted set std.net.accept with { listener set server timeout set 30.0 }
        using connection set accepted or give {
            keep request set std.web.read_request with {
                stream set connection
                maximum set 1048576
            } or give
            keep path set request.path
            keep headers set std.map.of with {
                key set "Content-Type"
                value set "text/plain; charset=utf-8"
            }
            keep sent set std.web.respond with {
                stream set connection
                status set 200
                headers set headers
                body set "Nivren received " + path
            } or give
            give ok(none)
        }
    }
}

keep opened set std.net.listen with { host set "127.0.0.1" port set 8080 }
choose opened {
    case Ok carries listener => serve_once with { listener set listener }
    case Err carries problem => err(problem)
}
