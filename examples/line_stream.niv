define count_valid_lines
takes {
    path is String
}
gives Int or Problem
needs FileRead
{
    keep opened set std.files.open_read with { path set path } or give
    using file set opened {
        keep lines set std.iter.lines with { file set file maximum_bytes set 65536 } or give
        change count set 0
        each line within lines {
            keep text set line or give
            change count to count + 1
        }
        give ok(count)
    }
}

count_valid_lines with { path set "events.log" }
