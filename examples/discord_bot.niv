// A minimal Discord message sender. Set DISCORD_BOT_TOKEN before running and
// replace the channel ID in the URL. The Network grant can be scoped to
// host:discord.com and Environment can remain an explicit project grant.
define send_message(text: String) gives Result<String, String> needs Environment, Network {
    keep token = std.env.get("DISCORD_BOT_TOKEN") ?? ""
    keep headers = std.map.single("Authorization", "Bot " + token)
        through std.map.set("Content-Type", "application/json")
    keep body = "{\"content\":\"" + text + "\"}"
    keep response = std.web.request(
        "POST",
        "https://discord.com/api/v10/channels/CHANNEL_ID/messages",
        headers,
        body,
        10.0,
        1048576
    ) or give
    give ok(std.map.get(response, "status") ?? "missing status")
}

send_message("Hello from Nivren")
