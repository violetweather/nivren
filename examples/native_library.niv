define add_with_library
takes {
    path is String
}
gives Int or Problem
needs Native
{
    keep opened set std.native.open with { path set path } or give
    using library set opened {
        give std.native.call_int with {
            library set library
            symbol set "nivren_add"
            arguments set [20, 22]
        }
    }
}

keep answer set add_with_library with { path set "./libnivren_example.so" }
show(choose answer {
    case Ok carries value => value
    case Err carries problem => -1
})
