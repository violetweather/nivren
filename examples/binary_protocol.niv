define protocol_id
gives Int or Problem
{
    keep magic set std.u16.from_int with { value set 20054 } or give
    keep version set std.u16.from_int with { value set 3 } or give
    keep header set std.binary.concat with {
        left set std.binary.u16_be with { value set magic }
        right set std.binary.u16_be with { value set version }
    } or give

    keep decoded_magic set std.binary.read_u16_be with {
        bytes set header
        offset set 0
    } or give
    give std.u16.to_int with { value set decoded_magic }
}

show(protocol_id with {})
