define signing_input
takes {
    header is String
    payload is String
}
gives String or Problem
{
    keep prefix set std.text.concat with { left set header right set "." } or give
    give std.text.concat with { left set prefix right set payload }
}

define issue
takes {
    payload_json is String
    secret is Bytes
}
gives String or Problem
{
    keep payload set std.json.compact with { source set payload_json } or give
    keep header set std.encoding.base64url_encode with {
        bytes set std.bytes.from_string with {
            value set "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
        }
    } or give
    keep encoded_payload set std.encoding.base64url_encode with {
        bytes set std.bytes.from_string with { value set payload }
    } or give
    keep message set signing_input with {
        header set header
        payload set encoded_payload
    } or give
    keep tag set std.crypto.hmac_sha256 with {
        key set secret
        message set std.bytes.from_string with { value set message }
    } or give
    keep signature set std.encoding.base64url_encode with { bytes set tag } or give
    keep prefix set std.text.concat with { left set message right set "." } or give
    give std.text.concat with { left set prefix right set signature }
}

keep secret set std.bytes.from_string with {
    value set "replace this with secret key material"
}
keep result set issue with { payload_json set "{\"sub\":\"user-42\"}" secret set secret }
keep message set choose result {
    case Ok carries token => token
    case Err carries problem => problem.message
}
show(message)
