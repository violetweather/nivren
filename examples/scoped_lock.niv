define count_twice
gives Int or Problem
needs Task
{
    keep counter set std.locks.create with { value set 0 }

    define increment
    gives Nothing or Problem
    needs Task
    {
        keep acquired set std.locks.acquire with { lock set counter timeout set 2.0 } or give
        using guard set acquired {
            keep current set std.locks.read with { guard set guard } or give
            keep written set std.locks.write with {
                guard set guard
                value set current + 1
            } or give
            give ok(none)
        }
    }

    keep completed set together [start increment, start increment] or give
    keep acquired set std.locks.acquire with { lock set counter timeout set 2.0 } or give
    using guard set acquired {
        give std.locks.read with { guard set guard }
    }
}

choose count_twice with {} {
    case Ok carries value => value
    case Err carries problem => -1
}
