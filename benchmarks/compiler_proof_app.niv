define load_payload
takes {
    path is String
}
gives String or String
needs FileRead
{
    keep contents set perform std.files.read with {
        path set path
    } or give
    give ok(contents)
}

define emit
takes {
    value is String
}
gives Nothing
{
    show(value)
    give none
}

choose perform load_payload with {
    path set "target/compiler-proof-input.txt"
} {
    case Ok carries contents => emit with { value set contents }
    case Err carries problem => emit with { value set problem }
}
