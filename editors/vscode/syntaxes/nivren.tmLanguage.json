{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nivren",
  "scopeName": "source.nivren",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    {
      "name": "constant.numeric.nivren",
      "match": "\\b(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b"
    },
    {
      "name": "constant.language.nivren",
      "match": "\\b(?:yes|no|none)\\b"
    },
    {
      "name": "keyword.control.nivren",
      "match": "\\b(?:when|otherwise|repeat|each|within|give|choose|case|carries|prepare|perform|through|start|wait|together|race|using|or)\\b"
    },
    {
      "name": "keyword.declaration.nivren",
      "match": "\\b(?:keep|change|set|to|define|takes|gives|needs|shape|choice|holds|with|from|is|maybe|protocol|adopt|for|use|expose|unsafe)\\b"
    },
    {
      "name": "storage.type.nivren",
      "match": "\\b(?:Int|Float|BigInt|Decimal|I8|I16|I32|U8|U16|U32|U64|String|Bool|Null|Result|Bytes|Map|Set|DateTime|Task|Channel|File|TcpListener|TcpStream|WebSocket|Lock|LockGuard|NativeHandle|NativeLibrary|Comparable|Number|Ordered|Iterable|Closable|Sendable)\\b"
    },
    {
      "name": "entity.name.function.nivren",
      "match": "(?<=\\bdefine\\s)[A-Za-z_][A-Za-z0-9_]*"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nivren",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.nivren",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nivren",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nivren",
          "match": "\\\\(?:[\\\"nrt]|u\\{[0-9A-Fa-f]+\\})"
        }
      ]
    }
  }
}
