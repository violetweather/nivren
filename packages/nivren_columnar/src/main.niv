shape IntColumn holds { name is String values is [Int] }
shape FloatColumn holds { name is String values is [Float] }
shape TextColumn holds { name is String values is [String] }

choice Column holds {
    case Ints carries IntColumn
    case Floats carries FloatColumn
    case Texts carries TextColumn
}

shape Table holds { rows is Int columns is [Column] }

define column_name
takes { column is Column }
gives String
{
    give choose column {
        case Ints carries value => value.name
        case Floats carries value => value.name
        case Texts carries value => value.name
    }
}

define column_length
takes { column is Column }
gives Int
{
    give choose column {
        case Ints carries value => len(value.values)
        case Floats carries value => len(value.values)
        case Texts carries value => len(value.values)
    }
}

define table
takes { columns is [Column] }
gives Table or Problem
{
    when len(columns) == 0 { give err(std.problems.create("columnar", "table requires at least one column")) }
    when len(columns) > 4096 { give err(std.problems.create("columnar", "table exceeds 4096 columns")) }
    keep rows set column_length with { column set columns[0] }
    when rows > 1000000 { give err(std.problems.create("columnar", "table exceeds one million rows")) }
    change names is [String] set []
    each column within columns {
        keep name set column_name with { column set column }
        when name == "" { give err(std.problems.create("columnar", "column names must not be empty")) }
        each existing within names { when existing == name { give err(std.problems.create("columnar", "column names must be unique")) } }
        when column_length with { column set column } != rows { give err(std.problems.create("columnar", "all columns must have the same row count")) }
        change names to append with { values set names value set name }
    }
    give ok(Table(rows, columns))
}

define select
takes { value is Table names is [String] }
gives Table or Problem
{
    when len(names) == 0 { give err(std.problems.create("columnar", "selection requires at least one column")) }
    change selected is [Column] set []
    each name within names {
        change found is maybe Column set none
        each column within value.columns {
            when column_name with { column set column } == name { change found to column }
        }
        when found == none { give err(std.problems.create("columnar", "selected column does not exist")) }
        change selected to append with { values set selected value set found ?? value.columns[0] }
    }
    give table with { columns set selected }
}

expose { IntColumn, FloatColumn, TextColumn, Column, Table, column_name, column_length, table, select }
