use "../src/main.niv"

keep packed set main.gzip_text with { text set "Nivren Nivren" level set 6 }
keep restored set choose packed {
    case Ok carries bytes => main.gunzip_text with { data set bytes maximum set 1024 }
    case Err carries problem => err(problem)
}
assert with { condition set restored == ok("Nivren Nivren") message set "gzip text roundtrip" }

keep input set std.bytes.from_string with { value set "portable" }
keep packed_zlib set main.zlib with { data set input level set 9 }
keep restored_zlib set choose packed_zlib {
    case Ok carries bytes => main.zlib_decode with { data set bytes maximum set 1024 }
    case Err carries problem => err(problem)
}
assert with { condition set restored_zlib == ok(input) message set "zlib roundtrip" }
