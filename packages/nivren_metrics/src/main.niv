shape Sample holds { name is String help is String kind is String value is Float labels is Map<String, String> }

define join
takes { left is String right is String }
gives String or Problem
{ give std.text.concat with { left set left right set right } }

define escape
takes { value is String help is Bool }
gives String or Problem
{
    when len(value) > 65536 { give err(std.problems.create("metrics", "metric text exceeds 64 KiB")) }
    change output set ""
    each character within value {
        change escaped set character
        when character == "\\" { change escaped to "\\\\" }
        when character == "\n" { change escaped to "\\n" }
        when character == "\"" and not help { change escaped to "\\\"" }
        change output to join with { left set output right set escaped } or give
    }
    give ok(output)
}

define sample
takes { name is String help is String kind is String value is Float labels is Map<String, String> }
gives Sample or Problem
{
    when name == "" or len(name) > 1024 { give err(std.problems.create("metrics", "metric name must contain 1 through 1024 characters")) }
    when kind != "counter" and kind != "gauge" { give err(std.problems.create("metrics", "metric kind must be counter or gauge")) }
    when std.map.length with { map set labels } > 128 { give err(std.problems.create("metrics", "metric sample exceeds 128 labels")) }
    give ok(Sample(name, help, kind, value, labels))
}

define encode
takes { samples is [Sample] }
gives String or Problem
{
    when len(samples) > 100000 { give err(std.problems.create("metrics", "metric export exceeds 100000 samples")) }
    change output set ""
    each item within samples {
        keep safe_help set escape with { value set item.help help set yes } or give
        each part within ["# HELP ", item.name, " ", safe_help, "\n# TYPE ", item.name, " ", item.kind, "\n", item.name] {
            change output to join with { left set output right set part } or give
        }
        keep keys set std.map.keys with { map set item.labels }
        when len(keys) > 0 {
            change output to join with { left set output right set "{" } or give
            change index set 0
            each key within keys {
                when index > 0 { change output to join with { left set output right set "," } or give }
                keep safe set escape with { value set std.map.get with { map set item.labels key set key } ?? "" help set no } or give
                each part within [key, "=\"", safe, "\""] {
                    change output to join with { left set output right set part } or give
                }
                change index to index + 1
            }
            change output to join with { left set output right set "}" } or give
        }
        change output to join with { left set output right set " " } or give
        change output to join with { left set output right set std.float.format with { value set item.value } or give } or give
        change output to join with { left set output right set "\n" } or give
    }
    give ok(output)
}

expose { Sample, sample, encode }
