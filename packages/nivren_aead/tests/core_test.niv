use "../src/main.niv"

define verify
gives Bool or String
{
    keep key set main.import_key with { bytes set std.bytes.from_string with { value set "0123456789abcdef0123456789abcdef" } } or give
    keep nonce set std.bytes.from_string with { value set "unique-nonce" }
    keep context set std.bytes.from_string with { value set "record:42" }
    keep message set std.bytes.from_string with { value set "protected" }
    keep sealed set main.seal_with_nonce with { key set key nonce set nonce context set context plaintext set message } or give
    keep opened set main.unseal with { key set key context set context sealed set sealed } or give
    assert with { condition set opened == message message set "authenticated encryption round trip" }
    keep rejected set choose main.unseal with { key set key context set std.bytes.from_string with { value set "record:43" } sealed set sealed } {
        case Ok carries value => no
        case Err carries problem => yes
    }
    give ok(rejected)
}

verify with {}
