shape Matrix holds {
    rows is Int
    columns is Int
    values is [Float]
}

define matrix
takes { rows is Int columns is Int values is [Float] }
gives Matrix or Problem
{
    when rows <= 0 or columns <= 0 { give err(std.problems.create("matrix", "matrix dimensions must be positive")) }
    when rows > 4096 or columns > 4096 { give err(std.problems.create("matrix", "matrix dimensions exceed 4096")) }
    when rows * columns != len(values) { give err(std.problems.create("matrix", "matrix value count does not match its dimensions")) }
    give ok(Matrix(rows, columns, values))
}

define at
takes { value is Matrix row is Int column is Int }
gives Float or Problem
{
    when row < 0 or row >= value.rows or column < 0 or column >= value.columns { give err(std.problems.create("matrix", "matrix index is out of bounds")) }
    give ok(value.values[row * value.columns + column])
}

define add
takes { left is Matrix right is Matrix }
gives Matrix or Problem
{
    when left.rows != right.rows or left.columns != right.columns { give err(std.problems.create("matrix", "matrix dimensions must match for addition")) }
    change values is [Float] set []
    change index set 0
    repeat index < len(left.values) {
        change values to append with { values set values value set left.values[index] + right.values[index] }
        change index to index + 1
    }
    give ok(Matrix(left.rows, left.columns, values))
}

define multiply
takes { left is Matrix right is Matrix }
gives Matrix or Problem
{
    when left.columns != right.rows { give err(std.problems.create("matrix", "inner matrix dimensions must match")) }
    when left.rows * right.columns > 1000000 { give err(std.problems.create("matrix", "matrix result exceeds one million values")) }
    change values is [Float] set []
    change row set 0
    repeat row < left.rows {
        change column set 0
        repeat column < right.columns {
            change total is Float set 0.0
            change inner set 0
            repeat inner < left.columns {
                change total to total + left.values[row * left.columns + inner] * right.values[inner * right.columns + column]
                change inner to inner + 1
            }
            change values to append with { values set values value set total }
            change column to column + 1
        }
        change row to row + 1
    }
    give ok(Matrix(left.rows, right.columns, values))
}

define transpose
takes { value is Matrix }
gives Matrix
{
    change values is [Float] set []
    change column set 0
    repeat column < value.columns {
        change row set 0
        repeat row < value.rows {
            change values to append with { values set values value set value.values[row * value.columns + column] }
            change row to row + 1
        }
        change column to column + 1
    }
    give Matrix(value.columns, value.rows, values)
}

expose { Matrix, matrix, at, add, multiply, transpose }
