use "../src/main.niv"

define verify
takes { }
gives Bool or String
{
    keep secret set std.bytes.from_string with { value set "a sufficiently long development secret" }
    keep token set main.sign_hs256 with { payload_json set "{\"sub\":\"42\",\"admin\":true}" secret set secret } or give
    keep payload set main.verify_hs256 with { token set token secret set secret } or give
    assert with { condition set payload == "{\"sub\":\"42\",\"admin\":true}" message set "compact verified payload" }
    keep rejected set choose main.verify_hs256 with { token set token secret set std.bytes.from_string with { value set "wrong secret" } } {
        case Ok carries value => no
        case Err carries problem => yes
    }
    keep seed set std.encoding.unhex with { source set "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60" } or give
    keep key set std.crypto.key_import with { bytes set seed } or give
    keep public set std.crypto.ed25519_public with { key set key } or give
    keep signed set main.sign_eddsa with { payload_json set "{\"sub\":\"42\"}" key set key } or give
    keep asymmetric set main.verify_eddsa with { token set signed public_key set public } or give
    keep confused set choose main.verify_hs256 with { token set signed secret set secret } {
        case Ok carries value => no
        case Err carries problem => yes
    }
    give ok(rejected and asymmetric == "{\"sub\":\"42\"}" and confused)
}

verify with { }
