use "../src/main.niv"

keep values: [Float] = [1.0, 2.0, 3.0, 4.0]
assert(main.sum(values) == 10.0, "sum")
assert(main.mean(values) == ok(2.5), "mean")
assert(main.variance(values) == ok(1.25), "population variance")
assert(main.minimum(values) == ok(1.0), "minimum")
assert(main.maximum(values) == ok(4.0), "maximum")
assert(main.normalize([2.0, 4.0, 6.0]) == ok([0.0, 0.5, 1.0]), "normalization")

choose main.mean([]) {
    Ok(value) => assert(no, "empty mean must fail"),
    Err(problem) => assert(yes, "empty mean rejected"),
}
