use "../src/main.niv"

keep encoded set main.hash_password_with_salt with {
    password set "correct horse battery staple"
    salt set std.bytes.from_string with { value set "0123456789abcdef" }
}
keep valid set choose encoded {
    case Ok carries hash => main.verify_password with { password set "correct horse battery staple" encoded set hash }
    case Err carries problem => err(problem)
}
assert with { condition set valid == ok(yes) message set "matching password" }

keep invalid set choose encoded {
    case Ok carries hash => main.verify_password with { password set "wrong" encoded set hash }
    case Err carries problem => err(problem)
}
assert with { condition set invalid == ok(no) message set "wrong password" }

keep key set perform main.random_key with { length set 32 }
keep correct_width set choose key {
    case Ok carries bytes => std.bytes.length with { bytes set bytes } == 32
    case Err carries problem => no
}
assert with { condition set correct_width message set "secure key width" }
