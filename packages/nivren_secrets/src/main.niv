define random_key
takes {
    length is Int
}
gives Bytes or String
needs Random
{
    give perform std.crypto.random_bytes with { length set length }
}

define hash_password
takes {
    password is String
}
gives String or String
needs Random
{
    keep salt set perform random_key with { length set 16 } or give
    give std.crypto.password_hash with { password set password salt set salt memory_kib set 19456 iterations set 2 lanes set 1 }
}

define hash_password_with_salt
takes {
    password is String
    salt is Bytes
}
gives String or String
{
    give std.crypto.password_hash with { password set password salt set salt memory_kib set 19456 iterations set 2 lanes set 1 }
}

define verify_password
takes {
    password is String
    encoded is String
}
gives Bool or String
{
    give std.crypto.password_verify with { password set password encoded set encoded }
}

expose { random_key, hash_password, hash_password_with_salt, verify_password }
