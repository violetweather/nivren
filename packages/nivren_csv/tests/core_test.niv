use "../src/main.niv"

define verify
gives Bool or Problem
{
    keep headers set ["name", "note"]
    keep rows set main.decode with { source set "Ada,\"hello, Nivren\"\r\nLin,portable\r\n" headers set headers maximum_rows set 10 } or give
    assert with { condition set len(rows) == 2 message set "two rows" }
    assert with { condition set std.map.get with { map set rows[0] key set "note" } == "hello, Nivren" message set "quoted field" }
    keep encoded set main.encode with { rows set rows headers set headers } or give
    keep decoded set main.decode with { source set encoded headers set headers maximum_rows set 10 } or give
    give ok(decoded == rows)
}

verify with {}
