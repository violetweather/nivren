shape Audio holds { sample_rate is Int channels is Int samples is [Int] }

define join
takes { left is Bytes right is Bytes }
gives Bytes or Problem
{ give std.binary.concat with { left set left right set right } }

define encode_pcm16
takes { value is Audio }
gives Bytes or Problem
{
    when value.sample_rate < 8000 or value.sample_rate > 384000 { give err(std.problems.create("wav", "sample rate must be 8000 through 384000")) }
    when value.channels < 1 or value.channels > 32 { give err(std.problems.create("wav", "channel count must be 1 through 32")) }
    when len(value.samples) > 8000000 { give err(std.problems.create("wav", "audio exceeds eight million samples")) }
    when len(value.samples) % value.channels != 0 { give err(std.problems.create("wav", "sample count must contain complete frames")) }
    keep channels set std.u16.from_int with { value set value.channels } or give
    keep sample_rate set std.u32.from_int with { value set value.sample_rate } or give
    keep byte_rate set std.u32.from_int with { value set value.sample_rate * value.channels * 2 } or give
    keep block_align set std.u16.from_int with { value set value.channels * 2 } or give
    keep data_size set std.u32.from_int with { value set len(value.samples) * 2 } or give
    keep riff_size set std.u32.from_int with { value set 36 + len(value.samples) * 2 } or give
    change output set std.bytes.from_string with { value set "RIFF" }
    change output to join with { left set output right set std.binary.u32_le with { value set riff_size } } or give
    change output to join with { left set output right set std.bytes.from_string with { value set "WAVEfmt " } } or give
    change output to join with { left set output right set std.binary.u32_le with { value set std.u32.from_int with { value set 16 } or give } } or give
    change output to join with { left set output right set std.binary.u16_le with { value set std.u16.from_int with { value set 1 } or give } } or give
    change output to join with { left set output right set std.binary.u16_le with { value set channels } } or give
    change output to join with { left set output right set std.binary.u32_le with { value set sample_rate } } or give
    change output to join with { left set output right set std.binary.u32_le with { value set byte_rate } } or give
    change output to join with { left set output right set std.binary.u16_le with { value set block_align } } or give
    change output to join with { left set output right set std.binary.u16_le with { value set std.u16.from_int with { value set 16 } or give } } or give
    change output to join with { left set output right set std.bytes.from_string with { value set "data" } } or give
    change output to join with { left set output right set std.binary.u32_le with { value set data_size } } or give
    each sample within value.samples {
        keep fixed set std.i16.from_int with { value set sample } or give
        change output to join with { left set output right set std.binary.i16_le with { value set fixed } } or give
    }
    give ok(output)
}

define decode_pcm16
takes { source is Bytes }
gives Audio or Problem
{
    when std.bytes.length with { bytes set source } < 44 { give err(std.problems.create("wav", "WAV input is shorter than its PCM header")) }
    keep riff set std.bytes.to_string with { bytes set std.bytes.slice with { bytes set source offset set 0 length set 4 } or give } or give
    keep wave set std.bytes.to_string with { bytes set std.bytes.slice with { bytes set source offset set 8 length set 12 } or give } or give
    keep format set std.bytes.to_string with { bytes set std.bytes.slice with { bytes set source offset set 12 length set 16 } or give } or give
    keep data set std.bytes.to_string with { bytes set std.bytes.slice with { bytes set source offset set 36 length set 40 } or give } or give
    when riff != "RIFF" or wave != "WAVE" or format != "fmt " or data != "data" { give err(std.problems.create("wav", "WAV must use the canonical PCM layout")) }
    keep encoding set std.u16.to_int with { value set std.binary.read_u16_le with { bytes set source offset set 20 } or give } or give
    keep channels set std.u16.to_int with { value set std.binary.read_u16_le with { bytes set source offset set 22 } or give } or give
    keep sample_rate set std.u32.to_int with { value set std.binary.read_u32_le with { bytes set source offset set 24 } or give } or give
    keep bits set std.u16.to_int with { value set std.binary.read_u16_le with { bytes set source offset set 34 } or give } or give
    keep data_size set std.u32.to_int with { value set std.binary.read_u32_le with { bytes set source offset set 40 } or give } or give
    when encoding != 1 or bits != 16 { give err(std.problems.create("wav", "WAV must contain signed 16-bit PCM")) }
    when data_size % 2 != 0 or 44 + data_size != std.bytes.length with { bytes set source } { give err(std.problems.create("wav", "WAV data size does not match its payload")) }
    when data_size > 16000000 { give err(std.problems.create("wav", "WAV payload exceeds 16 MiB")) }
    change samples is [Int] set []
    change offset set 44
    repeat offset < std.bytes.length with { bytes set source } {
        keep sample set std.i16.to_int with { value set std.binary.read_i16_le with { bytes set source offset set offset } or give } or give
        change samples to append with { values set samples value set sample }
        change offset to offset + 2
    }
    give ok(Audio(sample_rate, channels, samples))
}

expose { Audio, encode_pcm16, decode_pcm16 }
