use "../src/main.niv"

keep digest_width set choose main.fingerprint with { text set "Nivren" } {
    case Ok carries value => std.bytes.length with { bytes set value } == 32
    case Err carries problem => no
}
assert with { condition set digest_width message set "SHA-256 digest width" }

keep valid set choose main.sign with { key set "secret" message set "message" } {
    case Ok carries value => main.verify with { key set "secret" message set "message" tag set value } == ok(yes)
    case Err carries problem => no
}
assert with { condition set valid message set "matching tag" }

keep invalid set choose main.sign with { key set "secret" message set "message" } {
    case Ok carries value => main.verify with { key set "secret" message set "changed" tag set value } == ok(no)
    case Err carries problem => no
}
assert with { condition set invalid message set "changed message" }
