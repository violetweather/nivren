define fingerprint
takes {
    text is String
}
gives Bytes or String
{
    give std.crypto.sha256 with { bytes set std.bytes.from_string with { value set text } }
}

define sign
takes {
    key is String
    message is String
}
gives Bytes or String
{
    give std.crypto.hmac_sha256 with {
        key set std.bytes.from_string with { value set key }
        message set std.bytes.from_string with { value set message }
    }
}

define verify
takes {
    key is String
    message is String
    tag is Bytes
}
gives Bool or String
{
    give std.crypto.hmac_sha256_verify with {
        key set std.bytes.from_string with { value set key }
        message set std.bytes.from_string with { value set message }
        expected set tag
    }
}

expose { fingerprint, sign, verify }
