use "../src/main.niv"

define verify
gives Bool or Problem
{

keep window set main.Window with {
    title set "Nivren Desktop"
    width set 1280
    height set 800
    start_url set "app://index.html"
}
assert(main.validate_window with { window set window } == ok(window), "window policy")

keep message set main.BridgeMessage with {
    identifier set "request-1"
    command set "preferences.load"
    payload set "{}"
}
keep encoded set main.encode_message with { message set message } or give
assert(std.text.starts_with with { value set encoded prefix set "{" }, "typed JSON bridge")

keep update set main.UpdateManifest with {
    channel set "beta"
    version set "0.11.0-beta.1"
    url set "https://downloads.example.test/nivren-desktop.zip"
    sha256 set "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    signature set "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
}
assert(main.validate_update with { update set update } == ok(update), "signed update manifest")
give ok(yes)
}

verify with {}
