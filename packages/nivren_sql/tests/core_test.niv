use "../src/main.niv"

keep built = choose main.select("users", ["id", "name"]) {
    Ok(base) => main.where_equal(base, "role", "admin"),
    Err(problem) => err(problem),
}
keep text = choose built { Ok(query) => query.text, Err(problem) => "" }
keep parameters = choose built { Ok(query) => query.parameters, Err(problem) => [] }
assert(text == "SELECT id, name FROM users WHERE role = ?", "parameterized SQL")
assert(parameters == ["admin"], "parameter order")

assert(main.identifier("users; DROP TABLE users") == err("SQL identifier contains an unsafe character"), "reject injection")
