use "../src/main.niv"

keep built set choose main.select with { table set "users" columns set ["id", "name"] } {
    case Ok carries base => main.where_equal with { query set base column set "role" value set "admin" }
    case Err carries problem => err(problem)
}
keep text set choose built { case Ok carries query => query.text case Err carries problem => "" }
keep parameters set choose built { case Ok carries query => query.parameters case Err carries problem => [] }
assert with { condition set text == "SELECT id, name FROM users WHERE role = ?" message set "parameterized SQL" }
assert with { condition set parameters == ["admin"] message set "parameter order" }
assert with { condition set main.identifier with { value set "users; DROP TABLE users" } == err(std.problems.create("sql", "SQL identifier contains an unsafe character")) message set "reject injection" }
