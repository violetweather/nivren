use "../src/main.niv"

assert with { condition set main.expect_equal with { actual set 42 expected set 42 label set "answer" } == ok(none) message set "equal values pass" }
assert with { condition set main.expect_yes with { condition set yes label set "truth" } == ok(none) message set "yes passes" }
assert with { condition set main.expect_no with { condition set no label set "falsehood" } == ok(none) message set "no passes" }

define controlled
gives Bool or Problem
needs Task, Channel
{
    keep first set perform main.gate with {}
    keep second set perform main.gate with {}
    keep events set perform std.channels.create with { capacity set 2 }
    define one
    gives Nothing or Problem
    needs Channel
    {
        perform main.pass with { value set first } or give
        give perform main.checkpoint with { events set events label set "one" }
    }
    define two
    gives Nothing or Problem
    needs Channel
    {
        perform main.pass with { value set second } or give
        give perform main.checkpoint with { events set events label set "two" }
    }
    keep tasks set [start one, start two]
    perform main.open with { value set second } or give
    keep observed_second set perform std.channels.receive with { channel set events timeout set 5.0 } or give
    perform main.open with { value set first } or give
    keep observed_first set perform std.channels.receive with { channel set events timeout set 5.0 } or give
    together tasks or give
    give ok(observed_second == "two" and observed_first == "one")
}

perform controlled with {}
