use "../src/main.niv"

define works() gives Result<Bool, String> {
    keep verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    keep challenge = main.pkce_challenge(verifier) or give
    assert(challenge == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM", "RFC 7636 S256 vector")
    keep flow = main.authorization_url("https://identity.example/authorize", "nivren client", "https://app.example/callback", "openid profile", "state-0123456789", "nonce-0123456789", verifier) or give
    assert(std.text.starts_with(flow.url, "https://identity.example/authorize?response_type=code&client_id=nivren%20client"), "encoded authorization URL")
    keep payload = "{\"issuer\":\"https://identity.example\",\"audience\":\"nivren-client\",\"subject\":\"user-42\",\"expires_at\":2000,\"issued_at\":1000,\"nonce\":\"nonce-0123456789\"}"
    keep claims = main.validate_id_claims(payload, "https://identity.example", "nivren-client", "nonce-0123456789", 1500, 30) or give
    keep rejected = choose main.validate_claims(claims, "https://wrong.example", "nivren-client", "nonce-0123456789", 1500, 30) { Ok(value) => no, Err(problem) => yes }
    give ok(rejected and claims.subject == "user-42")
}

works()
