use "../src/main.niv"

define works
takes { }
gives Bool or Problem
{
    keep verifier set "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
    keep challenge set main.pkce_challenge with { verifier set verifier } or give
    assert with { condition set challenge == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM" message set "RFC 7636 S256 vector" }
    keep flow set main.authorization_url with {
        endpoint set "https://identity.example/authorize" client_id set "nivren client"
        redirect_uri set "https://app.example/callback" scope set "openid profile"
        state set "state-0123456789" nonce set "nonce-0123456789" verifier set verifier
    } or give
    assert with { condition set std.text.starts_with with { value set flow.url prefix set "https://identity.example/authorize?response_type=code&client_id=nivren%20client" } message set "encoded authorization URL" }
    keep payload set "{\"issuer\":\"https://identity.example\",\"audience\":\"nivren-client\",\"subject\":\"user-42\",\"expires_at\":2000,\"issued_at\":1000,\"nonce\":\"nonce-0123456789\"}"
    keep claims set main.validate_id_claims with { payload_json set payload expected_issuer set "https://identity.example" expected_audience set "nivren-client" expected_nonce set "nonce-0123456789" now set 1500 clock_skew set 30 } or give
    keep rejected set choose main.validate_claims with { value set claims expected_issuer set "https://wrong.example" expected_audience set "nivren-client" expected_nonce set "nonce-0123456789" now set 1500 clock_skew set 30 } {
        case Ok carries value => no
        case Err carries problem => yes
    }
    give ok(rejected and claims.subject == "user-42")
}

works with { }
