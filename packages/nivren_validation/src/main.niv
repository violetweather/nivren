shape Violation { field: String, message: String }

define required(field: String, value: String) gives Result<String, Violation> {
    when value != "" { give ok(value) }
    give err(Violation(field, "is required"))
}

define positive(field: String, value: Int) gives Result<Int, Violation> {
    when value > 0 { give ok(value) }
    give err(Violation(field, "must be positive"))
}

define range(field: String, value: Int, minimum: Int, maximum: Int) gives Result<Int, Violation> {
    when value >= minimum and value <= maximum { give ok(value) }
    give err(Violation(field, "is outside the allowed range"))
}

expose { Violation, required, positive, range }
