shape Violation holds {
    field is String
    message is String
} derives Json, Compare, Display, Validate

define required
takes {
    field is String
    value is String
}
gives String or Violation
{
    when value != "" {
        give ok(value)
    }
    give err(Violation with { field set field message set "is required" })
}

define positive
takes {
    field is String
    value is Int
}
gives Int or Violation
{
    when value > 0 {
        give ok(value)
    }
    give err(Violation with { field set field message set "must be positive" })
}

define range
takes {
    field is String
    value is Int
    minimum is Int
    maximum is Int
}
gives Int or Violation
{
    when value >= minimum and value <= maximum {
        give ok(value)
    }
    give err(Violation with { field set field message set "is outside the allowed range" })
}

expose { Violation, required, positive, range }
