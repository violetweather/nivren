use "../../packages/nivren_database/src/main.niv"

define fetch_users
gives Int or Problem
needs Native within "database"
{
    keep opened set perform main.open_driver with { configuration set "memory://product-proof" } or give
    using handle set opened {
        keep request set main.DriverRequest with {
            operation set "query"
            statement set "SELECT name FROM users"
            parameters set []
            maximum_rows set 10
            timeout set 5.0
        }
        keep page set perform main.query_driver with { handle set handle request set request } or give
        give ok(len(page.rows))
    }
}

perform fetch_users with {}
